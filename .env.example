APP_NAME="Chipper Farms"
# local | staging | production
APP_ENV=local
CHIPPER_SEED_DEFAULT_USERS=false
CHIPPER_SEED_DEMO_DATA=false
# Generate with: php artisan key:generate
APP_KEY=
# MUST be false in staging and production. Debug output leaks stack traces,
# configuration and query contents to end users.
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production targets MySQL/MariaDB. SQLite is for throwaway local use only;
# it does not reproduce the locking, decimal or transaction-isolation
# behaviour the finance and storefront concurrency paths depend on.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chipper_farms
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# MUST be true wherever the app is served over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Paystack
# --------------------------------------------------------------------------
# REQUIRED for the storefront. Without these the payment and refund paths
# raise PaymentException ("Paystack secret key is not configured").
#
# Use TEST keys (sk_test_ / pk_test_) in every non-production environment.
# Never commit real keys to this file — it is tracked in git.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=GHS
# Public URL Paystack redirects the customer back to after checkout.
PAYSTACK_CALLBACK_URL=

# --------------------------------------------------------------------------
# Finance operations
# --------------------------------------------------------------------------
# Recipient for scheduled finance job failure output (invoice reconciliation,
# loan interest accrual). Leave blank to disable failure email.
FINANCE_ALERT_EMAIL=
